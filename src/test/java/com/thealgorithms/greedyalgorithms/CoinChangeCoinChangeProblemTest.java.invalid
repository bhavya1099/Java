package com.thealgorithms.greedyalgorithms;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.TestInstance;
import org.junit.jupiter.api.TestInstance.Lifecycle;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Comparator;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class CoinChangeCoinChangeProblemTest {
    private CoinChange coinChange;
    @BeforeEach
    public void setUp() {
        coinChange = new CoinChange();
    }
    @Test
    @Tag("valid")
    public void testForZeroAmountInput() {
        // Arrange
        int amount = 0;
        // Act
        ArrayList<Integer> result = CoinChange.coinChangeProblem(amount);
        // Assert
        assertEquals(new ArrayList<>(), result);
    }
    @Test
    @Tag("valid")
    public void testForMaximumAmount() {
        // Arrange
        int amount = 2000;
        // Act
        ArrayList<Integer> result = CoinChange.coinChangeProblem(amount);
        // Assert
        assertEquals(Arrays.asList(2000), result);
    }
    @Test
    @Tag("valid")
    public void testForSmallAmountMultipleDenominations() {
        // Arrange
        int amount = 13;
        // Act
        ArrayList<Integer> result = CoinChange.coinChangeProblem(amount);
        // Assert
        assertEquals(Arrays.asList(10, 2, 1), result);
    }
    @Test
    @Tag("invalid")
    public void testForNegativeAmount() {
        // Arrange
        int amount = -100;
        // Act
        ArrayList<Integer> result = CoinChange.coinChangeProblem(amount);
        // Assert
        assertEquals(new ArrayList<>(), result);
    }
    @Test
    @Tag("boundary")
    public void testForLargeAmountExceedingDenominations() {
        // Arrange
        int amount = 2500;
        // Act
        ArrayList<Integer> result = CoinChange.coinChangeProblem(amount);
        // Assert
        assertEquals(Arrays.asList(2000, 500), result);
    }
}