package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Assertions;
import java.util.ArrayList;
import java.util.Arrays;

public class JobCompareToTest {
    @Test
    @Tag("valid")
    public void checkProfitDescendingOrder() {
        // Setup objects using valid constructor
        Job job1 = new Job('A', 5, 100);
        Job job2 = new Job('B', 3, 50);
        // Action: call compareTo method
        int comparisonResult = job1.compareTo(job2);
        // Assert: verify jobs are sorted by profit descending order
        Assertions.assertTrue(comparisonResult < 0); // job1 profit > job2 profit
    }
    @Test
    @Tag("valid")
    public void checkEqualProfitJobs() {
        // Setup objects using valid constructor
        Job job1 = new Job('A', 5, 75);
        Job job2 = new Job('B', 3, 75);
        // Action: call compareTo method
        int comparisonResult = job1.compareTo(job2);
        // Assert: verify jobs with equal profit comparison returns 0
        Assertions.assertEquals(0, comparisonResult); // job1 profit == job2 profit
    }
    @Test
    @Tag("valid")
    public void checkLowerProfitComparison() {
        // Setup objects using valid constructor
        Job job1 = new Job('A', 5, 50);
        Job job2 = new Job('B', 3, 100);
        // Action: call compareTo method
        int comparisonResult = job1.compareTo(job2);
        // Assert: verify job1 is less than job2
        Assertions.assertTrue(comparisonResult > 0); // job1 profit < job2 profit
    }
    @Test
    @Tag("boundary")
    public void checkNegativeProfitComparison() {
        // Setup objects using valid constructor
        Job job1 = new Job('A', 5, -100); // Allow negative profit for boundary condition
        Job job2 = new Job('B', 3, 50);
        // Action: call compareTo method
        int comparisonResult = job1.compareTo(job2);
        // Assert: ensure correct comparison even with negative profit
        Assertions.assertTrue(comparisonResult > 0); // job1 profit < job2 profit
    }
    @Test
    @Tag("invalid")
    public void checkComparisonWithNullJob() {
        // Setup objects using valid constructor
        Job job1 = new Job('A', 5, 50);
        // Action and Assert: ensure null comparison throws NullPointerException
        Assertions.assertThrows(NullPointerException.class, () -> {
            job1.compareTo(null);
        });
    }
}