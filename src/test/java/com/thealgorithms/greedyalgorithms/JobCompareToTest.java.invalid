    // Nested Job class for test purposes
    public static class Job {
        public char id;
        public int deadline;
        public int profit;
        public Job(char id, int deadline, int profit) {
            this.id = id;
            this.deadline = deadline;
            this.profit = profit;
        }
        @Override
        public int compareTo(Job otherJob) {
            return otherJob.profit - this.profit; 
        }
    }
    @Test
    @Tag("valid")
    public void testCompareJobsWithDifferentProfits() {
        // Arrange
        Job highProfitJob = new Job('A', 2, 100); // TODO: Change to desired profit value if needed
