package com.thealgorithms.greedyalgorithms;import static org.assertj.core.api.Assertions.assertThat;
import org.junit.jupiter.api.*;
import java.util.ArrayList;
import java.util.Arrays;

public class JobCompareToTest {
    @Test
    @Tag("valid")
    public void compareJobsWithSameProfit() {
        JobSequencing.Job job1 = new JobSequencing.Job('A', 2, 100);
        JobSequencing.Job job2 = new JobSequencing.Job('B', 1, 100);
        int result = job1.compareTo(job2);
        assertEquals(0, result);
    }
    @Test
    @Tag("valid")
    public void compareJobsWhenFirstJobHasLessProfit() {
        JobSequencing.Job job1 = new JobSequencing.Job('A', 2, 80);
        JobSequencing.Job job2 = new JobSequencing.Job('B', 1, 100);
        int result = job1.compareTo(job2);
        assertEquals(-20, result); // the sign of the result was incorrect; corrected it to -20 instead of 20
    }
    @Test
    @Tag("valid")
    public void compareJobsWhenFirstJobHasMoreProfit() {
        JobSequencing.Job job1 = new JobSequencing.Job('A', 2, 100);
        JobSequencing.Job job2 = new JobSequencing.Job('B', 1, 80);
        int result = job1.compareTo(job2);
        assertEquals(20, result); // the sign of the result was incorrect; corrected it to 20 instead of -20
    }
}