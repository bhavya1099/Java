package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import java.util.Arrays;

public class JobOfTest {
    @Test
    @Tag("valid")
    public void createJobWithValidParameters() {
        // Arrange
        String jobName = "A";
        int processingTime = 5;
        int deadline = 10;
        // Act
        MinimizingLateness.Job job = MinimizingLateness.Job.of(jobName, processingTime, deadline);
        // Assert
        assertNotNull(job, "Job object should not be null.");
        assertEquals(jobName, job.jobName, "Job name should be correctly assigned.");
        assertEquals(processingTime, (int) job.processingTime, "Processing time should be correctly assigned.");
        assertEquals(deadline, (int) job.deadline, "Deadline should be correctly assigned.");
    }
