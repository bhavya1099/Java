        // Arrange
        String jobName = "Job A";
        int processingTime = 5;
        int deadline = 10;
        // Act
        MinimizingLateness.Job job = new MinimizingLateness.Job(jobName, processingTime, deadline);
        // Assert
        assertEquals(jobName, (String) job.jobName, "Expected jobName mismatch");
        assertEquals(processingTime, (int) job.processingTime, "Expected processingTime mismatch");
        assertEquals(deadline, (int) job.deadline, "Expected deadline mismatch");
    }
