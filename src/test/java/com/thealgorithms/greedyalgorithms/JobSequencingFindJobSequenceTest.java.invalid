        jobs.add(new JobSequencing.Job(2, 0, 300));
        jobs.add(new JobSequencing.Job(3, 0, 200));
        jobs.sort(JobSequencing.Job::compareTo);
        
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: ", result);
    }
    @Tag("boundary")
    @Test
    @DisplayName("Handle jobs with a deadline value of 0")
