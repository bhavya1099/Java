        ArrayList<JobSequencing.Job> jobs = new ArrayList<>(Arrays.asList(
            new JobSequencing.Job(1, 50, 1),
            new JobSequencing.Job(2, 40, 2)
        ));
        String expectedOutput = "Job Sequence: ";
        String actualOutput = JobSequencing.findJobSequence(jobs, 0); // Invalid size
        assertEquals(expectedOutput, actualOutput);
    }
