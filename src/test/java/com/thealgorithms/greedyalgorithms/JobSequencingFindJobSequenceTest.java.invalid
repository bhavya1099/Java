        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job(1, 0, 100));
        jobs.add(new JobSequencing.Job(2, 2, 200));
        jobs.add(new JobSequencing.Job(3, 1, 300));
        jobs.sort(JobSequencing.Job::compareTo);
        // Suggestion for business logic: Ensure the function properly excludes jobs with a deadline of 0.
