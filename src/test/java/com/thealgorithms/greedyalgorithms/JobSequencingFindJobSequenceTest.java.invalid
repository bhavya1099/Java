package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.DisplayName;
import java.util.ArrayList;
import java.util.Arrays;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class JobSequencingFindJobSequenceTest {
    @Tag("valid")
    @Test
    @DisplayName("Verify Job Sequencing with jobs having the same profit and varied deadlines")
    public void jobSequencingWithSameProfitDifferentDeadlines() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job(1, 2, 100));
        jobs.add(new JobSequencing.Job(2, 1, 100));
        jobs.add(new JobSequencing.Job(3, 3, 100));
        jobs.sort(JobSequencing.Job::compareTo);
        
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: 2 -> 1 -> 3", result);
    }
    @Tag("boundary")
    @Test
    @DisplayName("Ensure proper handling of empty job lists")
    public void jobSequencingWithEmptyJobList() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        
        String result = JobSequencing.findJobSequence(jobs, 0);
        assertEquals("Job Sequence: ", result);
    }
    @Tag("valid")
    @Test
    @DisplayName("Test job scheduling when all deadlines exceed array size")
    public void jobSequencingWithDeadlinesExceedingSize() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job(1, 6, 100));
        jobs.add(new JobSequencing.Job(2, 7, 200));
        jobs.add(new JobSequencing.Job(3, 5, 150));
        jobs.sort(JobSequencing.Job::compareTo);
        
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: 2 -> 3 -> 1", result);
    }
    @Tag("valid")
    @Test
    @DisplayName("Verify sequencing when profits are in descending order")
    public void jobSequencingWithDescendingOrderProfits() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job(1, 2, 300));
        jobs.add(new JobSequencing.Job(2, 1, 200));
        jobs.add(new JobSequencing.Job(3, 3, 100));
        jobs.sort(JobSequencing.Job::compareTo);
        
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: 1 -> 2 -> 3", result);
    }
    @Tag("valid")
    @Test
    @DisplayName("Validate behavior with overlapping deadlines and equal profits")
    public void jobSequencingWithOverlappingDeadlinesAndEqualProfits() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job(1, 2, 100));
        jobs.add(new JobSequencing.Job(2, 2, 100));
        jobs.add(new JobSequencing.Job(3, 1, 100));
        jobs.sort(JobSequencing.Job::compareTo);
        // Suggestion for business logic: Ensure the function handles overlapping deadlines correctly by prioritizing by profit for these cases.
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: 3 -> 1", result);
    }
