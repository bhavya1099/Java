        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("A", 1, 15));
        jobs.add(new JobSequencing.Job("B", 2, 20));
        jobs.add(new JobSequencing.Job("C", 3, 25));
        jobs.add(new JobSequencing.Job("D", 4, 30));
