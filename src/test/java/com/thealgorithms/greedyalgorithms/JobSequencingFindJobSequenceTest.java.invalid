package com.thealgorithms.greedyalgorithms;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import java.util.ArrayList;
import org.junit.jupiter.api.*;
import java.util.Arrays;

public class JobSequencingFindJobSequenceTest {
    @Test
    @Tag("valid")
    public void handleEmptyJobList() {
        ArrayList<Job> jobs = new ArrayList<>();
        String result = JobSequencing.findJobSequence(jobs, 0);
        assertEquals("Job Sequence: ", result);
    }
    @Test
    @Tag("boundary")
    public void jobsExceedingSizeLimit() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 1, 100));
        jobs.add(new Job('B', 2, 19));
        jobs.add(new Job('C', 3, 27));
        jobs.add(new Job('D', 1, 25));
        jobs.add(new Job('E', 3, 15));
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: A -> B -> C", result);
    }
    @Test
    @Tag("valid")
    public void jobsWithIdenticalDeadlines() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 2, 100));
        jobs.add(new Job('B', 2, 19));
        jobs.add(new Job('C', 2, 27));
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: A -> B -> C", result);
    }
    @Test
    @Tag("invalid")
    public void jobListWithNullEntries() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 1, 100));
        jobs.add(null);
        jobs.add(new Job('B', 2, 19));
        jobs.add(null);
        String result = JobSequencing.findJobSequence(jobs, 4);
        assertEquals("Job Sequence: A -> B", result);
    }
    @Test
    @Tag("boundary")
    public void maximumDeadlineExceedingSize() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 5, 100)); // This deadline is greater than size
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertEquals("Job Sequence: ", result); // Expects empty sequence because the deadline exceeds size
    }
}