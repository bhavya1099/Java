package com.thealgorithms.greedyalgorithms;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
import java.util.ArrayList;
import java.util.Arrays;
import org.junit.jupiter.api.*;

public class JobSequencingFindJobSequenceTest {
    private ArrayList<Job> emptyJobs;
    private ArrayList<Job> singleJobList;
    private ArrayList<Job> sameDeadlineJobs;
    private ArrayList<Job> uniqueDeadlineJobs;
    private ArrayList<Job> descendingDeadlineJobs;
    private ArrayList<Job> largeSizeJobsList;
    private ArrayList<Job> allJobsSameDeadline;
    private ArrayList<Job> nullJobsList;
    @BeforeEach
    public void setup() {
        emptyJobs = new ArrayList<>();
        singleJobList = new ArrayList<>(Arrays.asList(new Job('A', 1, 50)));
        sameDeadlineJobs = new ArrayList<>(Arrays.asList(new Job('A', 2, 60), new Job('B', 2, 100), new Job('C', 2, 40)));
        uniqueDeadlineJobs = new ArrayList<>(Arrays.asList(new Job('A', 1, 30), new Job('B', 2, 20), new Job('C', 3, 10)));
        descendingDeadlineJobs = new ArrayList<>(Arrays.asList(new Job('A', 3, 30), new Job('B', 2, 20), new Job('C', 1, 10)));
        largeSizeJobsList = new ArrayList<>();
        for (int i = 0; i < 1000; i++) {
            largeSizeJobsList.add(new Job((char) ('A' + i), i + 1, i * 10));
        }
        allJobsSameDeadline = new ArrayList<>(Arrays.asList(new Job('A', 1, 20), new Job('B', 1, 30), new Job('C', 1, 40)));
        nullJobsList = null;
    }
    @Test
    @Tag("valid")
    public void testWhenJobsListIsEmpty() {
        assertEquals("", JobSequencing.findJobSequence(emptyJobs, 0));
    }
    @Test
    @Tag("valid")
    public void testWithOneJobAndSizeOne() {
        assertEquals("Job Sequence: A", JobSequencing.findJobSequence(singleJobList, 1));
    }
    @Test
    @Tag("valid")
    public void testWithJobsSameDeadlines() {
        assertEquals("Job Sequence: B -> A -> C", JobSequencing.findJobSequence(sameDeadlineJobs, 3));
    }
    @Test
    @Tag("valid")
    public void testWithJobsUniqueDeadlines() {
        assertEquals("Job Sequence: C -> B -> A", JobSequencing.findJobSequence(uniqueDeadlineJobs, 3));
    }
    @Test
    @Tag("valid")
    public void testWithDescendingDeadlines() {
        assertEquals("Job Sequence: A -> B -> C", JobSequencing.findJobSequence(descendingDeadlineJobs, 3));
    }
    @Test
    @Tag("valid")
    public void testWithLargeSizeJobsList() {
        String jobSequence = JobSequencing.findJobSequence(largeSizeJobsList, 1000);
        assertTrue(jobSequence.startsWith("Job Sequence:"));
    }
    @Test
    @Tag("valid")
    public void testWithAllJobsSameDeadline() {
        assertEquals("Job Sequence: A -> B -> C", JobSequencing.findJobSequence(allJobsSameDeadline, 3));
    }
    @Test
    @Tag("valid")
    public void testWithNullJobsList() {
        assertEquals("", JobSequencing.findJobSequence(nullJobsList, 0));
    }
}