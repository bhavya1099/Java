package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.assertj.core.api.Assertions.assertThat;
import java.util.ArrayList;
import java.util.Arrays;
import org.junit.jupiter.api.*;

public class JobSequencingFindJobSequenceTest {
    @Test
    @Tag("valid")
    public void handleEmptyJobList() {
        ArrayList<Job> jobs = new ArrayList<>();
        String result = JobSequencing.findJobSequence(jobs, 0);
        assertThat(result).isEqualTo("Job Sequence: ");
    }
    @Test
    @Tag("valid")
    public void singleJobBeforeDeadline() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("Job1", 1, 100));
        String result = JobSequencing.findJobSequence(jobs, 5);
        assertThat(result).isEqualTo("Job Sequence: Job1");
    }
    @Test
    @Tag("integration")
    public void multipleJobsOverlappingDeadlines() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("Job1", 3, 60));
        jobs.add(new Job("Job2", 1, 100));
        jobs.add(new Job("Job3", 2, 20));
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertThat(result).isEqualTo("Job Sequence: Job2 -> Job3 -> Job1");
    }
    @Test
    @Tag("boundary")
    public void jobsBeyondListSize() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("Job1", 2, 60));
        jobs.add(new Job("Job2", 4, 30)); // This job cannot be scheduled as deadline exceeds size
        jobs.add(new Job("Job3", 1, 10)); 
        String result = JobSequencing.findJobSequence(jobs, 3);
        assertThat(result).isEqualTo("Job Sequence: Job3 -> Job1");
    }
    @Test
    @Tag("valid")
    public void allSlotsFilledBeforeAllJobsProcessed() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("Job1", 1, 20));
        jobs.add(new Job("Job2", 1, 30));
        jobs.add(new Job("Job3", 1, 10));
        jobs.add(new Job("Job4", 1, 40));
        jobs.add(new Job("Job5", 1, 50)); 
        String result = JobSequencing.findJobSequence(jobs, 1);
        assertThat(result).isEqualTo("Job Sequence: Job1"); // Only Job1 fits because all others have same deadline but no slots available.
    }
}