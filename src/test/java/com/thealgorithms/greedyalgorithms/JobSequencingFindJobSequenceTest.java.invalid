package com.thealgorithms.greedyalgorithms;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.assertj.core.api.Assertions.assertThat;
import java.util.ArrayList;
import java.util.Collections;
import org.junit.jupiter.api.*;
import java.util.Arrays;

public class JobSequencingFindJobSequenceTest {
    @Test
    @Tag("valid")
    public void testValidSortedJobSequence() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 1, 100));
        jobs.add(new Job('B', 2, 50));
        jobs.add(new Job('C', 3, 15));
        Collections.sort(jobs, (j1, j2) -> j1.deadline - j2.deadline);
        String expectedSequence = "Job Sequence: A -> B -> C";
        String actualSequence = JobSequencing.findJobSequence(jobs, jobs.size());
        assertThat(actualSequence).isEqualTo(expectedSequence);
    }
    @Test
    @Tag("valid")
    public void testValidUnsortedJobSequence() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('C', 3, 20));
        jobs.add(new Job('B', 1, 10));
        jobs.add(new Job('A', 2, 40));
        String expectedSequence = "Job Sequence: B -> A -> C";
        String actualSequence = JobSequencing.findJobSequence(jobs, jobs.size());
        assertThat(actualSequence).isEqualTo(expectedSequence);
    }
    @Test
    @Tag("boundary")
    public void testDeadlineExceedsSlots() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 2, 60));
        jobs.add(new Job('B', 4, 30));  // This job cannot be scheduled as deadline exceeds slot size.
        jobs.add(new Job('C', 1, 10));  
        String expectedSequence = "Job Sequence: C -> A";
        String actualSequence = JobSequencing.findJobSequence(jobs, 2);
        assertThat(actualSequence).isEqualTo(expectedSequence);
    }
    @Test
    @Tag("boundary")
    public void testSizeZero() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 1, 100));
        String expectedSequence = "Job Sequence: ";
        String actualSequence = JobSequencing.findJobSequence(jobs, 0);
        assertThat(actualSequence).isEqualTo(expectedSequence);
    }
    @Test
    @Tag("valid")
    public void testIdenticalDeadlines() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job('A', 2, 50));
        jobs.add(new Job('B', 2, 60));
        jobs.add(new Job('C', 2, 70));
        String expectedSequence = "Job Sequence: A -> B";
        String actualSequence = JobSequencing.findJobSequence(jobs, 2);
        assertThat(actualSequence).isEqualTo(expectedSequence);
    }
}