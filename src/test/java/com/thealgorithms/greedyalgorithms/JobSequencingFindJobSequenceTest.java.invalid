    void jobSequencingWithDuplicateJobIds() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 2, 100));
        jobs.add(new Job("a", 1, 80));
        jobs.add(new Job("b", 3, 70));
        jobs.add(new Job("b", 2, 60));
        
        Collections.sort(jobs);
        
