package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import java.util.ArrayList;
import org.junit.jupiter.api.*;
import java.util.Arrays;

public class JobSequencingFindJobSequenceTest {
    // Testing scenario: Job Sequence with Empty Job List
    @Test
    @Tag("boundary")
    public void testJobSequenceWithEmptyJobList() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        String jobSequence = JobSequencing.findJobSequence(jobs, 0);
        assertEquals("Job Sequence:", jobSequence);
    }
    // Testing scenario: Job Sequence with Single Job Entry
    @Test
    @Tag("valid")
    public void testJobSequenceWithSingleJob() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", 1, 5));
        String jobSequence = JobSequencing.findJobSequence(jobs, jobs.size());
        assertEquals("Job Sequence: Job1", jobSequence);
    }
    // Testing scenario: Job Sequence with All Jobs Having Same Deadline
    @Test
    @Tag("valid")
    public void testJobSequenceWithIdenticalDeadlineJobs() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", 1, 5));
        jobs.add(new JobSequencing.Job("Job2", 1, 10));
        jobs.add(new JobSequencing.Job("Job3", 1, 3));
        String jobSequence = JobSequencing.findJobSequence(jobs, jobs.size());
        assertTrue(jobSequence.startsWith("Job Sequence: Job2"));
    }
    // Testing scenario: Testing for the Exception Handling of Negative Deadline
    @Test
    @Tag("invalid")
    public void testJobSequenceWithNegativeDeadline() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", -1, 5));
        // The business logic can be improved to handle this error
        // instead of throwing ArrayIndexOutOfBoundsException, it should ideally throw an exception indicating invalid input
        assertThrows(IllegalArgumentException.class, () -> JobSequencing.findJobSequence(jobs, jobs.size()));
    }
}