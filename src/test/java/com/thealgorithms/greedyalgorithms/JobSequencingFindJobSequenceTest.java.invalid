package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.ArrayList;
import java.util.Collections;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;
import java.util.Arrays;

// Adding Job class JobSequencingFindJobSequenceTest since it's missing class JobSequencingFindJobSequenceTest implements Comparable<Job> {
    String id;
    int deadline;
    int profit;
    
    public Job(String id, int deadline, int profit) {
        this.id = id;
        this.deadline = deadline;
        this.profit = profit;
    }
    
    @Override
    public int compareTo(Job other) {
        return other.profit - this.profit; // Sort by profit in descending order
    }
} class JobSequencingFindJobSequenceTest {
    @Test
    @Tag("valid")
    @DisplayName("Job sequencing with multiple jobs")
    void jobSequencingWithMultipleJobs() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 2, 100));
        jobs.add(new Job("b", 1, 19));
        jobs.add(new Job("c", 2, 27));
        jobs.add(new Job("d", 1, 25));
        jobs.add(new Job("e", 3, 15));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 3);
        
        assertEquals("Job Sequence: a -> c -> e", result);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Job sequencing with empty job list")
    void jobSequencingWithEmptyJobList() {
        ArrayList<Job> jobs = new ArrayList<>();
        
        String result = JobSequencing.findJobSequence(jobs, 0);
        
        assertEquals("Job Sequence: ", result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Job sequencing with single job")
    void jobSequencingWithSingleJob() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 1, 50));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 1);
        
        assertEquals("Job Sequence: a", result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Job sequencing with same deadlines")
    void jobSequencingWithSameDeadlines() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 1, 100));
        jobs.add(new Job("b", 1, 19));
        jobs.add(new Job("c", 1, 27));
        jobs.add(new Job("d", 1, 25));
        jobs.add(new Job("e", 1, 15));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 1);
        
        assertEquals("Job Sequence: a", result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Job sequencing with insufficient slots")
    void jobSequencingWithInsufficientSlots() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 2, 100));
        jobs.add(new Job("b", 1, 80));
        jobs.add(new Job("c", 2, 70));
        jobs.add(new Job("d", 1, 60));
        jobs.add(new Job("e", 3, 50));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 2);
        
        assertEquals("Job Sequence: b -> a", result);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Job sequencing with zero deadline jobs")
    void jobSequencingWithZeroDeadlineJobs() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 0, 100));
        jobs.add(new Job("b", 2, 80));
        jobs.add(new Job("c", 0, 70));
        jobs.add(new Job("d", 1, 60));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 2);
        
        assertEquals("Job Sequence: d -> b", result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Job sequencing with large deadlines")
    void jobSequencingWithLargeDeadlines() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 10, 100));
        jobs.add(new Job("b", 5, 80));
        jobs.add(new Job("c", 7, 70));
        jobs.add(new Job("d", 3, 60));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 10);
        
        assertEquals("Job Sequence: d -> b -> c -> a", result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Job sequencing with negative profit jobs")
    void jobSequencingWithNegativeProfitJobs() {
        ArrayList<Job> jobs = new ArrayList<>();
        jobs.add(new Job("a", 2, 100));
        jobs.add(new Job("b", 1, -20));
        jobs.add(new Job("c", 3, 70));
        jobs.add(new Job("d", 2, -10));
        
        Collections.sort(jobs);
        
        String result = JobSequencing.findJobSequence(jobs, 3);
        
        assertEquals("Job Sequence: a -> c -> d", result);
    }
    
    @Test
