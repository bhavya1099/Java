package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import java.util.ArrayList;
import java.util.Arrays;
import static org.junit.jupiter.api.Assertions.assertEquals;

class JobSequencingFindJobSequenceTest {
    @Test
    @Tag("valid")
    public void findJobSequenceWithEmptyList() {
        // Test Scenario 1: Validate the behavior when the job list is empty
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>(); // Prepare empty job list
        int size = 0;
        String result = JobSequencing.findJobSequence(jobs, size);
        assertEquals("Job Sequence: ", result); // Verify output matches expectation
    }
    @Test
    @Tag("boundary")
    public void findJobSequenceWithZeroSize() {
        // Test Scenario 2: Validate the behavior with a job list but size is 0
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", 1, 100)); // Add dummy job
        jobs.add(new JobSequencing.Job("Job2", 2, 200));
        int size = 0;
        String result = JobSequencing.findJobSequence(jobs, size);
        assertEquals("Job Sequence: ", result); // Verify output matches
    }
    @Test
    @Tag("boundary")
    public void findJobSequenceWithDeadlineExceedsSize() {
        // Test Scenario 3: Case where job deadline exceeds the given size
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", 5, 100)); // Deadline is larger than the list size
        jobs.add(new JobSequencing.Job("Job2", 3, 200));
        int size = 2;
        String result = JobSequencing.findJobSequence(jobs, size);
        assertEquals("Job Sequence: Job2 -> ", result); // Jobs exceeding deadline are not allocated
    }
    @Test
    @Tag("valid")
    public void findJobSequenceWithOptimalFit() {
        // Test Scenario 4: Case where all jobs perfectly fit deadline slots
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", 1, 100)); // Job deadlines match perfectly within slots
        jobs.add(new JobSequencing.Job("Job2", 2, 200));
        jobs.add(new JobSequencing.Job("Job3", 3, 300));
        int size = 3;
        String result = JobSequencing.findJobSequence(jobs, size);
        assertEquals("Job Sequence: Job3 -> Job2 -> Job1", result); // Expected order based on profit
    }
    @Test
    @Tag("valid")
    public void findJobSequenceWithConflictResolution() {
        // Test Scenario 5: Jobs conflict on the same slot -> Higher profit gets priority
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        jobs.add(new JobSequencing.Job("Job1", 2, 100)); // Two jobs competing for slot 2
        jobs.add(new JobSequencing.Job("Job2", 2, 300)); // Higher profit for Job2
        jobs.add(new JobSequencing.Job("Job3", 1, 200)); // Occupies earlier slot
        int size = 2;
        String result = JobSequencing.findJobSequence(jobs, size);
        assertEquals("Job Sequence: Job3 -> Job2", result); // Expected sequence based on priority
    }
}