package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import java.util.ArrayList;
import java.util.Arrays;
import static org.junit.jupiter.api.Assertions.assertEquals;

class JobSequencingFindJobSequenceTest {
    private static class Job implements Comparable<Job> {
        public final int id;
        public final int profit;
        public final int deadline;
        public Job(int id, int profit, int deadline) {
            this.id = id;
            this.profit = profit;
            this.deadline = deadline;
        }
        @Override
        public int compareTo(Job otherJob) {
            return otherJob.profit - this.profit;
        }
    }
    @Test
    @Tag("valid")
    public void testFindJobSequenceValidScenario() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>(Arrays.asList(
            new JobSequencing.Job(1, 35, 3),
            new JobSequencing.Job(2, 30, 4),
            new JobSequencing.Job(3, 25, 4),
            new JobSequencing.Job(4, 20, 2),
            new JobSequencing.Job(5, 15, 2)
        ));
        String expectedOutput = "Job Sequence: 1 -> 3 -> 2 -> 4";
        String actualOutput = JobSequencing.findJobSequence(jobs, 4);
        assertEquals(expectedOutput, actualOutput);
    }
    @Test
    @Tag("invalid")
    public void testFindJobSequenceInvalidDeadlineScenario() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>(Arrays.asList(
            new JobSequencing.Job(1, 50, -1), // Invalid deadline
            new JobSequencing.Job(2, 40, -10),
            new JobSequencing.Job(3, 30, -5)
        ));
        String expectedOutput = "Job Sequence: ";
        String actualOutput = JobSequencing.findJobSequence(jobs, 2);
        assertEquals(expectedOutput, actualOutput);
    }
    @Test
    @Tag("boundary")
    public void testFindJobSequenceBoundaryEmptyJobs() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>();
        String expectedOutput = "Job Sequence: ";
        String actualOutput = JobSequencing.findJobSequence(jobs, 2);
        assertEquals(expectedOutput, actualOutput);
    }
    @Test
    @Tag("boundary")
    public void testFindJobSequenceBoundarySingleJob() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>(Arrays.asList(
            new JobSequencing.Job(1, 50, 1)
        ));
        String expectedOutput = "Job Sequence: 1";
        String actualOutput = JobSequencing.findJobSequence(jobs, 1);
        assertEquals(expectedOutput, actualOutput);
    }
    @Test
    @Tag("integration")
    public void testFindJobSequenceIntegrationScenario() {
        ArrayList<JobSequencing.Job> jobs = new ArrayList<>(Arrays.asList(
            new JobSequencing.Job(1, 100, 2),
            new JobSequencing.Job(2, 50, 2),
            new JobSequencing.Job(3, 20, 1),
            new JobSequencing.Job(4, 10, 1)
        ));
        String expectedOutput = "Job Sequence: 1 -> 3";
        String actualOutput = JobSequencing.findJobSequence(jobs, 2);
        assertEquals(expectedOutput, actualOutput);
    }
    @Test
    @Tag("invalid")
