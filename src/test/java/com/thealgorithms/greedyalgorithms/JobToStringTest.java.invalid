        // Arrange
        MinimizingLateness.Job job1 = new MinimizingLateness.Job("Job1", 4, 8);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job("Job2", 8, 15);
        // Calculate lateness logic needs accessibility in MinimizingLateness class
