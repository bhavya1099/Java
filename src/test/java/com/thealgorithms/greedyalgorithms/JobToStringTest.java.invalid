        // Arrange
        MinimizingLateness.Job job = new MinimizingLateness.Job("JobInvalid", -2, -5);
        job.startTime = -10; // Modify this value based on invalid case setup
        job.lateness = 0;    // Correct logical setup of lateness
        // Act
