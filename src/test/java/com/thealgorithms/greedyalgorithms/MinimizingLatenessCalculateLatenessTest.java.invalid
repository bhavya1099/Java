package com.thealgorithms.greedyalgorithms;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;
import java.util.Arrays;

public class MinimizingLatenessCalculateLatenessTest {
    @Test
    @Tag("valid")
    public void testCalculateLatenessWithNoJobs() {
        Job[] jobs = new Job[0];
        assertDoesNotThrow(() -> MinimizingLateness.calculateLateness(jobs));
        assertEquals(0, jobs.length, "No jobs should be processed.");
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessWithOneJobOnTime() {
        Job job = Job.of("Job1", 3, 10);
        Job[] jobs = new Job[]{job};
        assertDoesNotThrow(() -> MinimizingLateness.calculateLateness(jobs));
        assertEquals(0, job.lateness, "Lateness should be 0 as the job ends before the deadline.");
    }
    @Test
    @Tag("integration")
    public void testMultipleJobsOrderedByDeadline() {
        Job job1 = Job.of("Job1", 2, 5);
        Job job2 = Job.of("Job2", 1, 3);
        Job job3 = Job.of("Job3", 4, 10);
        Job[] jobs = new Job[]{job1, job2, job3};
        assertDoesNotThrow(() -> MinimizingLateness.calculateLateness(jobs));
        // Validate job latenesses
        assertEquals(2, job1.lateness, "Lateness for Job1 should be correctly calculated.");
        assertEquals(2, job2.lateness, "Lateness for Job2 should be correctly calculated.");
        assertEquals(2, job3.lateness, "Lateness for Job3 should be correctly calculated.");
    }
    @Test
    @Tag("invalid")
    public void testJobWithProcessingTimeBeyondDeadline() {
        Job job = Job.of("Job1", 10, 5);
        Job[] jobs = new Job[]{job};
        assertDoesNotThrow(() -> MinimizingLateness.calculateLateness(jobs));
        assertEquals(5, job.lateness, "Lateness should be 5 as the job ends after the deadline.");
    }
    @Test
    @Tag("integration")
    public void testSequentialJobsImpactingStartTimes() {
        Job job1 = Job.of("Job1", 2, 5);
        Job job2 = Job.of("Job2", 3, 9);
        Job job3 = Job.of("Job3", 1, 12);
        Job[] jobs = new Job[]{job1, job2, job3};
        assertDoesNotThrow(() -> MinimizingLateness.calculateLateness(jobs));
        // Validate start times
        assertEquals(0, job1.startTime, "Start time for Job1 should be 0.");
        assertEquals(2, job2.startTime, "Start time for Job2 should be 2.");
        assertEquals(5, job3.startTime, "Start time for Job3 should be 5.");
        // Validate lateness values
        assertEquals(0, job1.lateness, "Lateness for Job1 should be 0.");
        assertEquals(0, job2.lateness, "Lateness for Job2 should be 0.");
        assertEquals(0, job3.lateness, "Lateness for Job3 should be 0.");
    }
}