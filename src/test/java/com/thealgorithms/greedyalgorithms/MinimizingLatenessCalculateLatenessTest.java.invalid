package com.thealgorithms.greedyalgorithms;import java.util.Arrays;

static void calculateLateness(Job... jobs) {
   if (jobs == null)
        throw new NullPointerException("Jobs array is null");
   Arrays.sort(jobs, (a, b) -> a.deadline - b.deadline);
   int startTime = 0;
   for (Job job : jobs) {
       job.startTime = startTime;
       startTime += job.processingTime;
       
       job.lateness = Math.max(0, startTime - job.deadline);
   }
}