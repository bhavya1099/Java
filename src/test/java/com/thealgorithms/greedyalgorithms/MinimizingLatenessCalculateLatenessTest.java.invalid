package com.thealgorithms.greedyalgorithms;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import java.util.Arrays;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class MinimizingLatenessCalculateLatenessTest {
    static class Job {
        String name;
        int processingTime;
        int deadline;
        int startTime;
        int lateness;

        static Job of(String name, int processingTime, int deadline) {
            Job job = new Job();
            job.name = name;
            job.processingTime = processingTime;
            job.deadline = deadline;
            job.startTime = 0;
            job.lateness = 0;
            return job;
        }
    }

    @Test
    @Tag("valid")
    public void verifySortingByDeadline() {
        Job job1 = Job.of("Job1", 3, 5);
        Job job2 = Job.of("Job2", 2, 3);
        Job job3 = Job.of("Job3", 4, 8);
        Job[] jobs = {job1, job2, job3};
        MinimizingLateness.calculateLateness(jobs);
        assertArrayEquals(new Job[]{job2, job1, job3}, jobs);
    }

    @Test
    @Tag("boundary")
    public void checkZeroProcessingTimeLateness() {
        Job job = Job.of("JobZero", 0, 2);
        MinimizingLateness.calculateLateness(new Job[]{job});
        assertEquals(0, job.lateness);
    }

    @Test
    @Tag("valid")
    public void ensureDeadlinesMetNoLateness() {
        Job job1 = Job.of("Job1", 2, 5);
        Job job2 = Job.of("Job2", 3, 8);
        Job job3 = Job.of("Job3", 1, 9);
        Job[] jobs = {job1, job2, job3};
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(0, jobs[0].lateness);
        assertEquals(0, jobs[1].lateness);
        assertEquals(0, jobs[2].lateness);
    }

    @Test
    @Tag("boundary")
    public void singleJobSchedulingValidation() {
        Job job = Job.of("SingleJob", 3, 5);
        MinimizingLateness.calculateLateness(new Job[]{job});
        assertEquals(Math.max(0, job.processingTime - job.deadline), job.lateness);
    }

    @Test
    @Tag("valid")
    public void overlappingDeadlinesBehavior() {
        Job job1 = Job.of("Job1", 3, 6);
        Job job2 = Job.of("Job2", 5, 7);
        Job job3 = Job.of("Job3", 2, 8);
        Job[] jobs = {job1, job2, job3};
        MinimizingLateness.calculateLateness(jobs);
        assertTrue(job1.lateness >= 0);
        assertTrue(job2.lateness >= 0);
        assertTrue(job3.lateness >= 0);
    }

    @Test
    @Tag("integration")
    public void scalabilityForLargeJobCount() {
        Job[] jobs = new Job[100];
        for (int i = 0; i < jobs.length; i++) {
            jobs[i] = Job.of("Job" + i, i % 5 + 1, i * 2 + 10);
        }
        MinimizingLateness.calculateLateness(jobs);
        Arrays.stream(jobs).forEach(job -> assertTrue(job.lateness >= 0));
    }

    @Test
    @Tag("boundary")
    public void checkEdgeDeadlineProcessingTimeCondition() {
        Job job1 = Job.of("Job1", 3, 3);
        Job job2 = Job.of("Job2", 5, 5);
        Job[] jobs = {job1, job2};
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(0, jobs[0].lateness);
        assertEquals(0, jobs[1].lateness);
    }

    @Test
    @Tag("invalid")
    public void handleNegativeDeadlineValues() {
        Job job1 = Job.of("Job1", 3, -2);
        Job job2 = Job.of("Job2", 5, -7);
        Job[] jobs = {job1, job2};
        MinimizingLateness.calculateLateness(jobs);
        assertTrue(job1.lateness >= 0);
        assertTrue(job2.lateness >= 0);
    }

    @Test
    @Tag("boundary")
    public void zeroDeadlineValidation() {
        Job job1 = Job.of("Job1", 3, 0);
        Job job2 = Job.of("Job2", 5, 0);
        Job[] jobs = {job1, job2};
        MinimizingLateness.calculateLateness(jobs);
        assertTrue(job1.lateness >= 0);
        assertTrue(job2.lateness >= 0);
    }

    @Test
    @Tag("boundary")
    public void longProcessingTimeJobsHandling() {
        Job job1 = Job.of("Job1", 7, 3);
        Job job2 = Job.of("Job2", 10, 5);
        Job[] jobs = {job1, job2};
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(Math.max(0, job1.startTime + job1.processingTime - job1.deadline), job1.lateness);
        assertEquals(Math.max(0, job2.startTime + job2.processingTime - job2.deadline), job2.lateness);
    }
}

