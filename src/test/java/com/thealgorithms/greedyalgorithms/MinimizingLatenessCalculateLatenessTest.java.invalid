package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.Arrays;
import static org.assertj.core.api.Assertions.assertThat;
import org.junit.jupiter.api.*;

class MinimizingLatenessCalculateLatenessTest {
    @Test
    @Tag("boundary")
    void emptyJobArray() {
        // No assertions needed, just verifying no exceptions are thrown
        MinimizingLateness.calculateLateness();
    }
    
    @Test
    @Tag("valid")
    void singleJobCalculation() {
        MinimizingLateness.Job job = new MinimizingLateness.Job(5, 10);
        
        MinimizingLateness.calculateLateness(job);
        
        assertThat(job.startTime).isEqualTo(0);
        assertThat(job.lateness).isEqualTo(0);
    }
    
    @Test
    @Tag("valid")
    void jobsWithNoLateness() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(3, 5);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(2, 8);
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(4, 15);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assertThat(job1.lateness).isEqualTo(0);
        assertThat(job2.lateness).isEqualTo(0);
        assertThat(job3.lateness).isEqualTo(0);
    }
    
    @Test
    @Tag("valid")
    void jobsWithLateness() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(3, 2);  // Will be late
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(2, 6);  // Will be on time
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(4, 8);  // Will be late
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assertThat(job1.lateness).isEqualTo(1);  // Finishes at 3, deadline is 2
        assertThat(job2.lateness).isEqualTo(0);  // Finishes at 5, deadline is 6
        assertThat(job3.lateness).isEqualTo(1);  // Finishes at 9, deadline is 8
    }
    
    @Test
    @Tag("valid")
    void jobsSortingByDeadline() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(3, 10);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(2, 5);
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(4, 7);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        // Jobs should be processed in order of deadlines: job2, job3, job1
        assertThat(job2.startTime).isEqualTo(0);
        assertThat(job3.startTime).isEqualTo(2);
        assertThat(job1.startTime).isEqualTo(6);
    }
    
    @Test
    @Tag("boundary")
    void jobsWithSameDeadline() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(3, 5);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(2, 5);
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(4, 5);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        // With same deadlines, order doesn't matter for minimizing lateness
        // But we should verify lateness is calculated correctly
        assertThat(job1.lateness).isEqualTo(4);  // Finishes at 9, deadline is 5
        assertThat(job2.lateness).isEqualTo(0);  // Finishes at 2, deadline is 5
        assertThat(job3.lateness).isEqualTo(8);  // Finishes at 13, deadline is 5
    }
    
    @Test
    @Tag("boundary")
    void zeroProcessingTimeJobs() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(0, 5);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(3, 10);
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(0, 15);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assertThat(job1.startTime).isEqualTo(0);
        assertThat(job1.lateness).isEqualTo(0);
        
        assertThat(job2.startTime).isEqualTo(0);
        assertThat(job2.lateness).isEqualTo(0);
        
        assertThat(job3.startTime).isEqualTo(3);
        assertThat(job3.lateness).isEqualTo(0);
    }
    
    @Test
    @Tag("boundary")
    void negativeDeadlineJobs() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(3, -2);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(2, 5);
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(4, -1);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        // Jobs with negative deadlines should be scheduled first
        assertThat(job1.startTime).isEqualTo(0);
        assertThat(job3.startTime).isEqualTo(3);
        assertThat(job2.startTime).isEqualTo(7);
        
        assertThat(job1.lateness).isEqualTo(5);  // Finishes at 3, deadline is -2
        assertThat(job3.lateness).isEqualTo(8);  // Finishes at 7, deadline is -1
        assertThat(job2.lateness).isEqualTo(4);  // Finishes at 9, deadline is 5
    }
    
    @Test
    @Tag("valid")
    void largeNumberOfJobs() {
        MinimizingLateness.Job[] jobs = new MinimizingLateness.Job[1000];
        for (int i = 0; i < 1000; i++) {
            jobs[i] = new MinimizingLateness.Job(i % 5, i % 10);
        }
        
        MinimizingLateness.calculateLateness(jobs);
        
        // Verify jobs are processed in deadline order
        for (int i = 1; i < jobs.length; i++) {
            if (jobs[i-1].deadline == jobs[i].deadline) {
                continue;
            }
            assertThat(jobs[i-1].deadline).isLessThanOrEqualTo(jobs[i].deadline);
        }
        
        // Verify startTime and lateness calculations
        int expectedStartTime = 0;
        for (int i = 0; i < jobs.length; i++) {
            assertThat(jobs[i].startTime).isEqualTo(expectedStartTime);
            expectedStartTime += jobs[i].processingTime;
            int expectedLateness = Math.max(0, expectedStartTime - jobs[i].deadline);
            assertThat(jobs[i].lateness).isEqualTo(expectedLateness);
        }
    }
    
    @Test
    @Tag("valid")
    void consistencyOfResults() {
        MinimizingLateness.Job job1 = new MinimizingLateness.Job(3, 5);
        MinimizingLateness.Job job2 = new MinimizingLateness.Job(2, 8);
        MinimizingLateness.Job job3 = new MinimizingLateness.Job(4, 3);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        int job1StartTime = job1.startTime;
        int job2StartTime = job2.startTime;
        int job3StartTime = job3.startTime;
        
        int job1Lateness = job1.lateness;
        int job2Lateness = job2.lateness;
        int job3Lateness = job3.lateness;
        
        // Call the method again with the same jobs
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        // Verify results are the same
        assertThat(job1.startTime).isEqualTo(job1StartTime);
        assertThat(job2.startTime).isEqualTo(job2StartTime);
        assertThat(job3.startTime).isEqualTo(job3StartTime);
        
        assertThat(job1.lateness).isEqualTo(job1Lateness);
        assertThat(job2.lateness).isEqualTo(job2Lateness);
        assertThat(job3.lateness).isEqualTo(job3Lateness);
    }
}