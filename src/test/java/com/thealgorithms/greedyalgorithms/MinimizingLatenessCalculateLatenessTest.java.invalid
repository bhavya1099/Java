        MinimizingLateness.Job[] jobs = {};
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(0, jobs.length); // No jobs to process, array remains empty
    }
    @Test
    @Tag("boundary")
    public void testJobsWithZeroDeadlines() {
        MinimizingLateness.Job[] jobs = {
