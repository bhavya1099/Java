package com.thealgorithms.greedyalgorithms;import java.util.Arrays;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class MinimizingLatenessCalculateLatenessTest {
    private static class Job {
        public String jobName;
        public int startTime;
        public int lateness;
        public int processingTime;
        public int deadline;
        public Job(String jobName, int processingTime, int deadline) {
            this.jobName = jobName;
            this.processingTime = processingTime;
            this.deadline = deadline;
        }
        public static Job of(String jobName, int processingTime, int deadline) {
            return new Job(jobName, processingTime, deadline);
        }
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessWithNoJobs() {
        Job[] jobs = {};
        MinimizingLateness.calculateLateness(jobs);
        for (Job job : jobs) {
            assertEquals(0, job.lateness, "Lateness should remain zero for no job processed");
        }
    }
    @Test
    @Tag("valid")
    public void testAllJobsMeetDeadlines() {
        Job[] jobs = {
            Job.of("Job1", 1, 5),
            Job.of("Job2", 2, 10),
            Job.of("Job3", 3, 15),
        };
        MinimizingLateness.calculateLateness(jobs);
        for (Job job : jobs) {
            assertEquals(0, job.lateness, "Lateness should be zero for jobs meeting deadlines");
        }
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessWithJobDeadlineExceed() {
        Job job1 = Job.of("Job1", 3, 4); // Should be late
        Job job2 = Job.of("Job2", 2, 8); // On time
        Job[] jobs = { job1, job2 };
        MinimizingLateness.calculateLateness(jobs);
        assertTrue(job1.lateness > 0, "Lateness should be greater than zero for jobs that exceed their deadline");
        assertEquals(0, job2.lateness, "Lateness should be zero for jobs that meet their deadlines");
    }
    @Test
    @Tag("boundary")
    public void testJobsWithIdenticalDeadlines() {
        Job job1 = Job.of("Job1", 2, 10);
        Job job2 = Job.of("Job2", 1, 10);
        Job[] jobs = { job1, job2 };
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(0, job1.lateness, "Initial job with shortest processing time should have 0 lateness");
        assertEquals(0, job2.lateness, "Second job with identical deadline should also have 0 lateness");
    }
    @Test
    @Tag("invalid")
    public void testJobsWithZeroOrNegativeProcessingTime() {
        Job job1 = Job.of("Job1", 0, 10); // Zero processing time
        Job job2 = Job.of("Job2", -1, 15); // Negative processing time, should be treated as zero
        Job[] jobs = { job1, job2 };
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(0, job1.lateness, "Job with zero processing time should not be late");
        assertEquals(0, job2.lateness, "Job with negative processing time should not be late");
    }
}