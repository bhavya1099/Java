package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import java.util.Arrays;

public class MinimizingLatenessCalculateLatenessTest {
    static class Job {
        String jobName;
        int processingTime;
        int deadline;
        int startTime;
        int lateness;
        public Job(String jobName, int processingTime, int deadline) {
            this.jobName = jobName;
            this.processingTime = processingTime;
            this.deadline = deadline;
            this.startTime = 0; // Default initialization
            this.lateness = 0; // Default initialization
        }
        @Override
        public String toString() {
            return String.format("%s, startTime: %d, endTime: %d, lateness: %d", jobName, startTime, processingTime + startTime, lateness);
        }
    }
    @Tag("valid")
    @Test
    public void calculateSingleJobZeroLateness() {
        Job job1 = new Job("Job1", 3, 3);
        MinimizingLateness.calculateLateness(job1);
        assertEquals(0, (int) job1.lateness);
    }
    @Tag("valid")
    @Test
    public void calculateMultipleJobsSortedByDeadline() {
        Job job1 = new Job("Job1", 2, 7);
        Job job2 = new Job("Job2", 4, 5);
        MinimizingLateness.calculateLateness(job1, job2);
        assertEquals("Job1", job1.jobName); 
        assertEquals(2, (int) job1.lateness);
        assertEquals(1, (int) job2.lateness);
    }
    @Tag("boundary")
    @Test
    public void calculateZeroProcessingTimeJobs() {
        Job job1 = new Job("Job1", 0, 5);
        MinimizingLateness.calculateLateness(job1);
        assertEquals(Math.max(0, (int) (job1.startTime - job1.deadline)), (int) job1.lateness);
    }
    @Tag("invalid")
    @Test
    public void calculateNegativeDeadlineEdgeCase() {
        Job job1 = new Job("Job1", 3, -5);
        MinimizingLateness.calculateLateness(job1);
        assertEquals(Math.max(0, (int) (job1.startTime + job1.processingTime - job1.deadline)), (int) job1.lateness);
    }
    @Tag("valid")
    @Test
    public void validateStartTimeForMultipleJobs() {
        Job job1 = new Job("Job1", 3, 9);
        Job job2 = new Job("Job2", 2, 6);
        MinimizingLateness.calculateLateness(job1, job2);
        assertEquals(0, (int) job2.startTime);
        assertEquals((int) job2.processingTime, (int) job1.startTime);
    }
    @Tag("boundary")
    @Test
    public void calculateEmptyJobList() {
        Job[] jobs = new Job[0];
        
        assertDoesNotThrow(() -> MinimizingLateness.calculateLateness(jobs));
    }
    @Tag("valid")
    @Test
    public void calculateJobsWithSameDeadlines() {
        Job job1 = new Job("Job1", 2, 7);
        Job job2 = new Job("Job2", 3, 7);
        MinimizingLateness.calculateLateness(job1, job2);
        assertEquals(0, (int) job1.lateness);
        assertEquals((int) job2.processingTime, (int) job2.lateness);
    }
    @Tag("integration")
    @Test
    public void calculateLargeJobListPerformance() {
        Job[] jobs = new Job[1000];
        for (int i = 0; i < 1000; i++) {
            jobs[i] = new Job("Job" + i, i % 5 + 1, i % 10 + 5); 
        }
        MinimizingLateness.calculateLateness(jobs);
        assertNotNull(jobs[0].lateness);
        assertTrue(jobs[jobs.length - 1].lateness >= 0);
    }
}