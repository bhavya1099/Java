package com.thealgorithms.greedyalgorithms;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.Arrays;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class MinimizingLatenessCalculateLatenessTest {
    @Test
    @Tag("valid")
    public void testCalculateLatenessForZeroProcessingTime() {
        Job job = Job.of("Job1", 0, 0);
        MinimizingLateness.calculateLateness(job);
        assertEquals(0, job.lateness);
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessForMultipleJobs() {
        Job job1 = Job.of("Job1", 2, 5);
        Job job2 = Job.of("Job2", 3, 7);
        MinimizingLateness.calculateLateness(job1, job2);
        assertEquals(0, job1.lateness);
        assertEquals(1, job2.lateness);
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessForSameDeadlineDifferentProcessingTimes() {
        Job job1 = Job.of("Job1", 4, 10);
        Job job2 = Job.of("Job2", 2, 10);
        MinimizingLateness.calculateLateness(job1, job2);
        assertEquals(0, job1.lateness);
        assertEquals(2, job2.lateness);
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessForNegativeProcessingTime() {
        Job job = Job.of("Job1", -3, 5);
        MinimizingLateness.calculateLateness(job);
        assertEquals(0, job.lateness);
    }
    @Test
    @Tag("valid")
    public void testCalculateLatenessForLargeNumberOfJobs() {
        Job[] jobs = new Job[100];
        for (int i = 0; i < 100; i++) {
            jobs[i] = Job.of("Job" + i, i + 1, i + 10);
        }
        MinimizingLateness.calculateLateness(jobs);
        assertEquals(0, jobs[0].lateness);
        assertEquals(0, jobs[1].lateness);
        assertEquals(0, jobs[2].lateness);
    }
}