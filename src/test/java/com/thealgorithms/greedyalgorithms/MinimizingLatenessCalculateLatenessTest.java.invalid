package com.thealgorithms.greedyalgorithms;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.Arrays;
import org.junit.jupiter.api.*;

class MinimizingLatenessCalculateLatenessTest {
    
    // Define the Job class that was missing in the original test
    static class Job {
        String name;
        int processingTime;
        int deadline;
        int startTime;
        int lateness;
        
        private Job(String name, int processingTime, int deadline) {
            this.name = name;
            this.processingTime = processingTime;
            this.deadline = deadline;
        }
        
        public static Job of(String name, int processingTime, int deadline) {
            return new Job(name, processingTime, deadline);
        }
    }
    
    @Test
    @Tag("boundary")
    void emptyJobArray() {
        // No assertions needed, just verifying no exceptions are thrown
        MinimizingLateness.calculateLateness();
    }
    
    @Test
    @Tag("valid")
    void singleJob() {
        Job job = Job.of("Job1", 5, 10);
        
        MinimizingLateness.calculateLateness(job);
        
        assert job.startTime == 0;
        assert job.lateness == 0; // 5 (endTime) - 10 (deadline) = -5, max(0, -5) = 0
    }
    
    @Test
    @Tag("valid")
    void jobsAlreadySortedByDeadline() {
        Job job1 = Job.of("Job1", 3, 5);
        Job job2 = Job.of("Job2", 4, 8);
        Job job3 = Job.of("Job3", 2, 10);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assert job1.startTime == 0;
        assert job1.lateness == 0; // 3 - 5 = -2, max(0, -2) = 0
        
        assert job2.startTime == 3;
        assert job2.lateness == 0; // 7 - 8 = -1, max(0, -1) = 0
        
        assert job3.startTime == 7;
        assert job3.lateness == 0; // 9 - 10 = -1, max(0, -1) = 0
    }
    
    @Test
    @Tag("valid")
    void jobsInReverseDeadlineOrder() {
        Job job1 = Job.of("Job1", 2, 10);
        Job job2 = Job.of("Job2", 4, 8);
        Job job3 = Job.of("Job3", 3, 5);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        // After sorting, the order should be job3, job2, job1
        assert job3.startTime == 0;
        assert job3.lateness == 0; // 3 - 5 = -2, max(0, -2) = 0
        
        assert job2.startTime == 3;
        assert job2.lateness == 0; // 7 - 8 = -1, max(0, -1) = 0
        
        assert job1.startTime == 7;
        assert job1.lateness == 0; // 9 - 10 = -1, max(0, -1) = 0
    }
    
    @Test
    @Tag("boundary")
    void jobsWithSameDeadline() {
        Job job1 = Job.of("Job1", 3, 10);
        Job job2 = Job.of("Job2", 4, 10);
        Job job3 = Job.of("Job3", 2, 10);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        // Jobs with same deadline should maintain their original order after sorting
        assert job1.startTime == 0;
        assert job1.lateness == 0; // 3 - 10 = -7, max(0, -7) = 0
        
        assert job2.startTime == 3;
        assert job2.lateness == 0; // 7 - 10 = -3, max(0, -3) = 0
        
        assert job3.startTime == 7;
        assert job3.lateness == 0; // 9 - 10 = -1, max(0, -1) = 0
    }
    
    @Test
    @Tag("valid")
    void noLateJobs() {
        Job job1 = Job.of("Job1", 3, 10);
        Job job2 = Job.of("Job2", 4, 15);
        Job job3 = Job.of("Job3", 2, 20);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assert job1.startTime == 0;
        assert job1.lateness == 0; // 3 - 10 = -7, max(0, -7) = 0
        
        assert job2.startTime == 3;
        assert job2.lateness == 0; // 7 - 15 = -8, max(0, -8) = 0
        
        assert job3.startTime == 7;
        assert job3.lateness == 0; // 9 - 20 = -11, max(0, -11) = 0
    }
    
    @Test
    @Tag("valid")
    void allLateJobs() {
        Job job1 = Job.of("Job1", 3, 1);
        Job job2 = Job.of("Job2", 4, 2);
        Job job3 = Job.of("Job3", 2, 3);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assert job1.startTime == 0;
        assert job1.lateness == 2; // 3 - 1 = 2, max(0, 2) = 2
        
        assert job2.startTime == 3;
        assert job2.lateness == 5; // 7 - 2 = 5, max(0, 5) = 5
        
        assert job3.startTime == 7;
        assert job3.lateness == 6; // 9 - 3 = 6, max(0, 6) = 6
    }
    
    @Test
    @Tag("valid")
    void mixedLateAndOnTimeJobs() {
        Job job1 = Job.of("Job1", 3, 2);  // Will be late
        Job job2 = Job.of("Job2", 4, 10); // On time
        Job job3 = Job.of("Job3", 2, 6);  // On time
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assert job1.startTime == 0;
        assert job1.lateness == 1; // 3 - 2 = 1, max(0, 1) = 1
        
        assert job3.startTime == 3;
        assert job3.lateness == 0; // 5 - 6 = -1, max(0, -1) = 0
        
        assert job2.startTime == 5;
        assert job2.lateness == 0; // 9 - 10 = -1, max(0, -1) = 0
    }
    
    @Test
    @Tag("boundary")
    void zeroProcessingTimeJobs() {
        Job job1 = Job.of("Job1", 0, 5);
        Job job2 = Job.of("Job2", 4, 8);
        Job job3 = Job.of("Job3", 0, 10);
        
        MinimizingLateness.calculateLateness(job1, job2, job3);
        
        assert job1.startTime == 0;
        assert job1.lateness == 0; // 0 - 5 = -5, max(0, -5) = 0
        
        assert job2.startTime == 0;
        assert job2.lateness == 0; // 4 - 8 = -4, max(0, -4) = 0
        
        assert job3.startTime == 4;
        assert job3.lateness == 0; // 4 - 10 = -6, max(0, -6) = 0
    }
    
    @Test
    @Tag("valid")
    void largeNumberOfJobs() {
        // Create 1000 jobs with random processing times and deadlines
        Job[] jobs = new Job[1000];
        for (int i = 0; i < 1000; i++) {
            int processingTime = i % 10 + 1; // 1 to 10
            int deadline = i + 10; // Ensures some jobs will be late
            jobs[i] = Job.of("Job" + i, processingTime, deadline);
        }
        
        MinimizingLateness.calculateLateness(jobs);
        
        // Check a sample of jobs
        assert jobs[0].startTime >= 0;
        
        // Verify jobs are sorted by deadline
        for (int i = 1; i < jobs.length; i++) {
            assert jobs[i-1].deadline <= jobs[i].deadline;
        }
        
        // Verify start times are sequential
        for (int i = 1; i < jobs.length; i++) {
            assert jobs[i].startTime == jobs[i-1].startTime + jobs[i-1].processingTime;
        }
        
        // Verify lateness calculation
        for (Job job : jobs) {
            int endTime = job.startTime + job.processingTime;
            assert job.lateness == Math.max(0, endTime - job.deadline);
        }
    }
}